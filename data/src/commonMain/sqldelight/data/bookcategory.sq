import kotlin.Boolean;
import kotlin.Long;
import kotlin.String;
import kotlin.Int;
import kotlin.Float;

CREATE TABLE IF NOT EXISTS bookcategories(
    _id INTEGER PRIMARY KEY NOT NULL  ,
    book_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    FOREIGN KEY(category_id) REFERENCES categories (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(book_id) REFERENCES book (_id)
    ON DELETE CASCADE
);

findAll:
SELECT * FROM bookcategories;

insert:
INSERT OR REPLACE INTO bookcategories(book_id,category_id) VALUES (:bookId,:categoryId);


deleteMangaCategoryByMangaId:
DELETE FROM bookcategories
WHERE book_id = :mangaId;

deleteAll:
DELETE FROM bookcategories;

delete:
DELETE FROM bookcategories WHERE category_id= :categoryId;

deleteByBookId:
DELETE FROM bookcategories WHERE bookcategories.book_id = :bookId;

deleteByBookIdAndCategoryId:
DELETE FROM bookcategories WHERE book_id = :bookId AND category_id = :categoryId;
findByCategoryId:
SELECT * FROM bookcategories WHERE category_id=:categoryId;

restoreAssignment:
INSERT INTO bookcategories(book_id,category_id)
SELECT :bookId,:categoryId WHERE EXISTS(SELECT 1 FROM book WHERE _id=:bookId)
AND NOT EXISTS(SELECT 1 FROM bookcategories WHERE book_id=:bookId AND category_id=:categoryId);
